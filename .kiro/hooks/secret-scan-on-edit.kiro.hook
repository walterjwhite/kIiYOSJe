{
  "enabled": true,
  "name": "Secret scan after any edit",
  "description": "Scans changed and untracked files for API keys, private keys, and tokens. The product handles OAuth tokens and mail, so a leaked literal is the costliest mistake.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*"]
  },
  "then": {
    "type": "runCommand",
    "command": "node scripts/check-secrets.mjs"
  }
}
