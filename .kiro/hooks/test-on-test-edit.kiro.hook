{
  "enabled": true,
  "name": "Run the suite after a test edit",
  "description": "vitest is headless and fast enough to run whole; running it on every *.test.ts edit keeps the 27-file suite green instead of discovering breakage at the end.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/*.test.ts"]
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run --reporter=dot"
  }
}
