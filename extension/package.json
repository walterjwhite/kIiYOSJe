{
  "name": "mind-vscode",
  "displayName": "mind",
  "description": "Local attention manager — Queue, Signals, Directions, Learnings, Analytics, Journal, Devices",
  "version": "0.0.1",
  "publisher": "mind-local",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mind.queue",
        "title": "mind: Open Queue"
      },
      {
        "command": "mind.signals",
        "title": "mind: Open Signals"
      },
      {
        "command": "mind.directions",
        "title": "mind: Open Directions"
      },
      {
        "command": "mind.learnings",
        "title": "mind: Open Learnings"
      },
      {
        "command": "mind.analytics",
        "title": "mind: Open Analytics"
      },
      {
        "command": "mind.journal",
        "title": "mind: Open Journal"
      },
      {
        "command": "mind.systemEvents",
        "title": "mind: Open System Events"
      },
      {
        "command": "mind.modelTrace",
        "title": "mind: Open Model Trace"
      },
      {
        "command": "mind.devices",
        "title": "mind: Open Devices"
      },
      {
        "command": "mind.settings",
        "title": "mind: Open Settings"
      },
      {
        "command": "mind.capture",
        "title": "mind: Capture Thought"
      },
      {
        "command": "mind.pause",
        "title": "mind: Pause Sends (kill switch)"
      },
      {
        "command": "mind.resume",
        "title": "mind: Resume Sends"
      },
      {
        "command": "mind.direction.edit",
        "title": "mind: Edit Directions (YAML)"
      },
      {
        "command": "mind.direction.new",
        "title": "mind: New Direction"
      },
      {
        "command": "mind.ai.configure",
        "title": "mind: Configure AI Provider"
      },
      {
        "command": "mind.notifications.configure",
        "title": "mind: Configure Notification Quiet Period"
      },
      {
        "command": "mind.server.start",
        "title": "mind: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "mind.server.stop",
        "title": "mind: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mind.server.restart",
        "title": "mind: Restart Server",
        "icon": "$(debug-restart)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mind",
          "title": "mind",
          "icon": "media/mind-icon.svg"
        }
      ]
    },
    "views": {
      "mind": [
        {
          "id": "mind.nav",
          "name": "mind",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "mind",
      "properties": {
        "mind.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "mind server URL (must be localhost)"
        },
        "mind.pairingServerUrl": {
          "type": "string",
          "default": "",
          "description": "Address a phone should use when it scans a pairing QR code. Leave empty for this machine's private network address; set http://127.0.0.1:8787 when the phone reaches the server over USB with 'adb reverse' (android/deploy-debug.sh --local)."
        },
        "mind.debug": {
          "type": "boolean",
          "default": false,
          "description": "Show debug detail in a signal's \"How it was processed\" section: which AI provider, model and endpoint handled each step, how long each call took, token counts, and why a step was skipped. Prompt and message text are never included."
        },
        "mind.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Path to token file. Leave empty to use default (~/.config/kIiYOSJe/mind/token)."
        },
        "mind.serverRoot": {
          "type": "string",
          "default": "",
          "description": "Repo root containing packages/server/dist/main.js, used by Start/Restart Server. Leave empty to use an open workspace folder that contains it."
        },
        "mind.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable used to run the server. Leave empty for \"node\" on PATH. Must be the Node the server was built and installed with (Node 24+)."
        },
        "mind.serverEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables for a server started from the extension, e.g. {\"NODE_USE_ENV_PROXY\": \"1\", \"no_proxy\": \"localhost,127.0.0.1\"}."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "mind.server.start",
          "when": "view == mind.nav && !mind.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "mind.server.restart",
          "when": "view == mind.nav && mind.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "mind.server.stop",
          "when": "view == mind.nav && mind.serverRunning",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.144.0",
    "typescript": "7.0.2"
  }
}
