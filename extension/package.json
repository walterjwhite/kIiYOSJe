{
  "name": "mind-vscode",
  "displayName": "mind",
  "description": "Local attention manager — Thoughts, Review, Signals, Analytics, Journal, and Devices",
  "version": "0.0.1",
  "publisher": "mind-local",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mind.capture",
        "title": "mind: Capture Thought"
      },
      {
        "command": "mind.pause",
        "title": "mind: Pause Sends (kill switch)"
      },
      {
        "command": "mind.resume",
        "title": "mind: Resume Sends"
      },
      {
        "command": "mind.brief",
        "title": "mind: Open Today Brief"
      },
      {
        "command": "mind.direction.edit",
        "title": "mind: Edit Directions"
      },
      {
        "command": "mind.ai.configure",
        "title": "mind: Configure AI Provider"
      },
      {
        "command": "mind.thought.open",
        "title": "mind: Open Thought"
      },
      {
        "command": "mind.action.send",
        "title": "mind: Approve & Send"
      },
      {
        "command": "mind.action.discard",
        "title": "mind: Discard"
      },
      {
        "command": "mind.signals.setRange",
        "icon": "$(calendar)",
        "title": "mind: Set Signals Range"
      },
      {
        "command": "mind.signals.refresh",
        "icon": "$(refresh)",
        "title": "mind: Refresh Signals"
      },
      {
        "command": "mind.signal.reclassify",
        "title": "mind: Reclassify Signal"
      },
      {
        "command": "mind.journal.refresh",
        "icon": "$(refresh)",
        "title": "mind: Refresh Journal"
      },
      {
        "command": "mind.analytics",
        "title": "mind: Open Analytics"
      },
      {
        "command": "mind.devices",
        "title": "mind: Open Devices"
      },
      {
        "command": "mind.notifications.configure",
        "title": "mind: Configure Notification Quiet Period"
      },
      {
        "command": "mind.review.focus",
        "title": "mind: Focus Review"
      },
      {
        "command": "mind.refresh",
        "icon": "$(refresh)",
        "title": "mind: Refresh"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mind.brief",
          "group": "navigation",
          "when": "view == mind.thoughts"
        },
        {
          "command": "mind.capture",
          "group": "navigation",
          "when": "view == mind.thoughts"
        },
        {
          "command": "mind.refresh",
          "group": "navigation@3",
          "when": "view == mind.thoughts && mind.thoughts.error"
        },
        {
          "command": "mind.refresh",
          "group": "navigation@3",
          "when": "view == mind.review && mind.review.error"
        },
        {
          "command": "mind.signals.setRange",
          "when": "view == mind.signals",
          "group": "navigation@1"
        },
        {
          "command": "mind.signals.refresh",
          "when": "view == mind.signals",
          "group": "navigation@2"
        },
        {
          "command": "mind.journal.refresh",
          "when": "view == mind.journal",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mind.action.send",
          "when": "view == mind.review && viewItem == action",
          "group": "inline@1"
        },
        {
          "command": "mind.action.discard",
          "when": "view == mind.review && viewItem == action",
          "group": "inline@2"
        },
        {
          "command": "mind.signal.reclassify",
          "when": "view == mind.signals && viewItem == signal",
          "group": "inline@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mind",
          "title": "mind",
          "icon": "media/mind-icon.svg"
        }
      ]
    },
    "views": {
      "mind": [
        {
          "id": "mind.thoughts",
          "name": "Thoughts",
          "type": "tree"
        },
        {
          "id": "mind.review",
          "name": "Review",
          "type": "tree"
        },
        {
          "id": "mind.signals",
          "name": "Signals",
          "type": "tree"
        },
        {
          "id": "mind.journal",
          "name": "Journal",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mind.thoughts",
        "contents": "Nothing needs your attention right now.\n[Capture a thought](command:mind.capture) [Open Today Brief](command:mind.brief)"
      },
      {
        "view": "mind.review",
        "contents": "Nothing is awaiting your approval.\n[Open Today Brief](command:mind.brief)"
      },
      {
        "view": "mind.signals",
        "contents": "No signals have arrived today."
      },
      {
        "view": "mind.journal",
        "contents": "The journal fills in as signals are ingested.\n[Open Today Brief](command:mind.brief)"
      }
    ],
    "configuration": {
      "title": "mind",
      "properties": {
        "mind.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "mind server URL (must be localhost)"
        },
        "mind.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Path to token file. Leave empty to use default (~/.config/mind/token)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.144.0",
    "typescript": "7.0.2"
  }
}
