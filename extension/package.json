{
  "name": "mind-vscode",
  "displayName": "mind",
  "description": "Local attention manager — Queue, Today, Signals, Directions, Learnings, Analytics, Journal, Devices",
  "version": "0.0.1",
  "publisher": "mind-local",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mind.queue",
        "title": "mind: Open Queue"
      },
      {
        "command": "mind.brief",
        "title": "mind: Open Today Brief"
      },
      {
        "command": "mind.signals",
        "title": "mind: Open Signals"
      },
      {
        "command": "mind.directions",
        "title": "mind: Open Directions"
      },
      {
        "command": "mind.learnings",
        "title": "mind: Open Learnings"
      },
      {
        "command": "mind.analytics",
        "title": "mind: Open Analytics"
      },
      {
        "command": "mind.journal",
        "title": "mind: Open Journal"
      },
      {
        "command": "mind.systemEvents",
        "title": "mind: Open System Events"
      },
      {
        "command": "mind.devices",
        "title": "mind: Open Devices"
      },
      {
        "command": "mind.settings",
        "title": "mind: Open Settings"
      },
      {
        "command": "mind.capture",
        "title": "mind: Capture Thought"
      },
      {
        "command": "mind.pause",
        "title": "mind: Pause Sends (kill switch)"
      },
      {
        "command": "mind.resume",
        "title": "mind: Resume Sends"
      },
      {
        "command": "mind.direction.edit",
        "title": "mind: Edit Directions (YAML)"
      },
      {
        "command": "mind.direction.new",
        "title": "mind: New Direction"
      },
      {
        "command": "mind.ai.configure",
        "title": "mind: Configure AI Provider"
      },
      {
        "command": "mind.notifications.configure",
        "title": "mind: Configure Notification Quiet Period"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mind",
          "title": "mind",
          "icon": "media/mind-icon.svg"
        }
      ]
    },
    "views": {
      "mind": [
        {
          "id": "mind.nav",
          "name": "mind",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "mind",
      "properties": {
        "mind.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "mind server URL (must be localhost)"
        },
        "mind.debug": {
          "type": "boolean",
          "default": false,
          "description": "Show debug detail in a signal's \"How it was processed\" section: which AI provider, model and endpoint handled each step, how long each call took, token counts, and why a step was skipped. Prompt and message text are never included."
        },
        "mind.tokenPath": {
          "type": "string",
          "default": "",
          "description": "Path to token file. Leave empty to use default (~/.config/kIiYOSJe/mind/token)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.144.0",
    "typescript": "7.0.2"
  }
}
