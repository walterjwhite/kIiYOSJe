# Names only. Real values belong in the environment or ~/.config/kIiYOSJe/mind/credentials.yml
# (mode 600), never in this file. Copy to .env locally; .env is gitignored.

# Paths
# MIND_CONFIG_DIR=
# MIND_DATA_DIR=
# MIND_DB_PATH=
# MIND_DIRECTIONS_DIR=
# MIND_LEARNINGS_DIR=

# Logging
# MIND_LOG_LEVEL=info
# MIND_LOG_JSON=true

# Retention in days
# MIND_RETENTION_DAYS=90

# Sending. Leave unset or false until a source is verified and autonomy is chosen.
# MIND_SEND_ENABLED=false

# Model provider (default: local Ollama, no egress)
# MIND_AI_PROVIDER=ollama
# MIND_AI_BASE_URL=http://127.0.0.1:11434
# MIND_CLASSIFY_MODEL=
# MIND_DRAFT_MODEL=
# MIND_AI_API_KEY=            # only for cloud providers

# Google (Gmail, Calendar)
# MIND_GOOGLE_CLIENT_ID=
# MIND_GOOGLE_CLIENT_SECRET=
# MIND_GOOGLE_REFRESH_TOKEN=
# MIND_CALENDAR_ID=
# MIND_CALENDAR_ICS_URL=

# Microsoft (Outlook via Graph)
# MIND_OUTLOOK_TENANT_ID=
# MIND_OUTLOOK_CLIENT_ID=
# MIND_OUTLOOK_CLIENT_SECRET=
# MIND_OUTLOOK_REFRESH_TOKEN=

# Google Messages through your own mautrix-gmessages bridge
# MIND_GMESSAGES_HOMESERVER_URL=
# MIND_GMESSAGES_USER_ID=
# MIND_GMESSAGES_ACCESS_TOKEN=
