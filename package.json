{
  "name": "mind",
  "private": true,
  "version": "0.0.1",
  "description": "Local attention manager — events in, Thoughts out.",
  "license": "BSD-3-Clause",
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server",
    "test": "vitest run",
    "lint": "tsc --build",
    "license:check": "node scripts/check-licenses.mjs",
    "migrate": "npm run migrate --workspace=packages/core",
    "demo:seed": "npm run build --workspace=packages/demo-data --if-present && node packages/demo-data/dist/cli.js seed",
    "demo:reset": "node packages/demo-data/dist/cli.js reset",
    "demo:summary": "node packages/demo-data/dist/cli.js summary",
    "demo:serve": "node -e \"process.env.MIND_DB_PATH=require('os').homedir()+'/.data/kIiYOSJe/mind/demo.db'; process.env.MIND_RETENTION_DAYS='36500'; require('child_process').spawn('npm',['run','dev','--workspace=packages/server'],{stdio:'inherit',env:process.env})\""
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "better-sqlite3@13.2.0": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@vitest/coverage-v8": "5.1.0"
  }
}
